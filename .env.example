# Select one provider for new payout approvals. Existing withdrawals keep their persisted provider.
PAYOUT_PROVIDER=razorpayx
PAYOUT_FINGERPRINT_SECRET=

# Cashfree Payouts V2. Use sandbox credentials until onboarding and payout tests are complete.
CASHFREE_PAYOUT_ENV=sandbox
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01
CASHFREE_PAYOUT_TIMEOUT_MS=15000
# Optional when Cashfree requires x-cf-signature for API requests.
CASHFREE_PAYOUT_PUBLIC_KEY=
CASHFREE_PAYOUT_PUBLIC_KEY_PATH=

# RazorpayX settings remain supported for existing production payouts.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_TIMEOUT_MS=15000
