# Select one provider for new payout approvals. Existing withdrawals keep their persisted provider.
PAYOUT_PROVIDER=razorpayx
PAYOUT_FINGERPRINT_SECRET=
# Receives high and critical system alert emails from the shared alert module.
SYSTEM_MANAGER_EMAIL=
# Configure at least one mail transport for alert delivery.
GOOGLE_USER_MAIL=
GOOGLE_APP_PASSWORD=
SEND_GRID_API_KEY=
SEND_GRID_FROM_MAIL=

# Optional company contact details printed on completed payout statements.
HYDACON_COMPANY_NAME=Hydacon
HYDACON_COMPANY_EMAIL=
HYDACON_COMPANY_PHONE=
HYDACON_COMPANY_ADDRESS=

# Cashfree Payouts V2. Use sandbox until live onboarding and payout tests are complete.
CASHFREE_PAYOUT_BASE_URL=https://sandbox.cashfree.com/payout
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01
CASHFREE_PAYOUT_TIMEOUT_MS=15000
# Optional when Cashfree requires x-cf-signature for API requests.
CASHFREE_PAYOUT_PUBLIC_KEY=
CASHFREE_PAYOUT_PUBLIC_KEY_PATH=

# RazorpayX settings remain supported for existing production payouts.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_TIMEOUT_MS=15000
