# Runtime
# start:dev and start:prod set NODE_ENV automatically; this is for direct runs.
NODE_ENV=prod
PORT=3000
MONGODB_URL=

# Authentication and encrypted payout/bank data.
# Use independent, high-entropy values. Keep ENCRYPTION_SECRET stable: changing it
# makes data encrypted with the old value unreadable.
JWT_SECRET=
ENCRYPTION_SECRET=

# Optional override; if blank the payout idempotency fingerprint uses ENCRYPTION_SECRET.
PAYOUT_FINGERPRINT_SECRET=

# Required S3 configuration. The current S3 client requires static access keys.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis is needed for distributed background work in production. Local development
# can use redis://127.0.0.1:6379 or leave this unset for the development fallback.
REDIS_URL=

# Client and account URLs.
FRONTEND_URL=
# Comma-separated exact browser origins (scheme + host + optional port).
# Required in production; development permits local origins.
ALLOWED_ORIGINS=
# Optional overrides for user registration links sent by email/SMS.
USER_REGISTER_URL=
MOBILE_APP_REGISTER_URL=

# Google sign-in client IDs. Set the client IDs for the clients that support Google login.
WEB_GOOGLE_CLIENT_ID=
MOBILE_GOOGLE_CLIENT_ID=

# IFSC lookup base URL used during beneficiary bank validation.
RAZORPAY_IFSC_BASE_URL=https://ifsc.razorpay.com

# SMS delivery. SMS_PROVIDER currently supports only "twilio".
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Configure at least one email transport if the instance must send emails.
# Gmail: set both GOOGLE_USER_MAIL and GOOGLE_APP_PASSWORD.
GOOGLE_USER_MAIL=
GOOGLE_APP_PASSWORD=
# SendGrid: set SEND_GRID_API_KEY and SEND_GRID_FROM_MAIL.
SEND_GRID_API_KEY=
SEND_GRID_FROM_MAIL=
# Optional recipient for high and critical operational alert emails.
SYSTEM_MANAGER_EMAIL=

# Payout configuration. Provider selection accepts "razorpayx" or "cashfree".
# Manual payouts are selected through system configuration and need no provider API key.
PAYOUT_PROVIDER=razorpayx

# Cashfree Payouts V2. Keep sandbox configured until live onboarding is complete.
CASHFREE_PAYOUT_BASE_URL=https://sandbox.cashfree.com/payout
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Optional: defaults are provided by the application when blank.
CASHFREE_PAYOUT_API_VERSION=2024-01-01
CASHFREE_PAYOUT_TIMEOUT_MS=15000
# Optional request signing key; configure either the inline key or key path if required.
CASHFREE_PAYOUT_PUBLIC_KEY=
CASHFREE_PAYOUT_PUBLIC_KEY_PATH=

# RazorpayX credentials are required when PAYOUT_PROVIDER=razorpayx or for existing
# withdrawals assigned to RazorpayX.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_TIMEOUT_MS=15000

# Optional company details printed on completed payout statements.
HYDACON_COMPANY_NAME=Hydacon
HYDACON_COMPANY_EMAIL=
HYDACON_COMPANY_PHONE=
HYDACON_COMPANY_ADDRESS=

# Optional: enable the real Cashfree sandbox API test only when intentionally running it.
# Requires valid sandbox credentials and an existing sandbox transfer reference.
RUN_CASHFREE_SANDBOX_TESTS=false
CASHFREE_SANDBOX_TRANSFER_ID=
