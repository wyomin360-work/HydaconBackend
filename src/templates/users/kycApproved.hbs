<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KYC Documents Verified Successfully</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Plus Jakarta Sans", Arial, sans-serif;
        background-color: #f6f7fb;
        color: #333;
        margin: 0;
        padding: 20px;
      }

      .container {
        max-width: 620px;
        margin: auto;
        background: #ffffff;
        padding: 32px;
        border-radius: 14px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
      }

      .header {
        text-align: center;
        margin-bottom: 25px;
      }

      h2 {
        color: #2e7d32;
        font-weight: 600;
        margin-bottom: 10px;
      }

      p {
        line-height: 1.7;
        font-size: 16px;
        margin: 14px 0;
      }

      .info-box {
        margin-top: 25px;
        padding: 16px;
        background-color: #e8f5e9;
        border-radius: 12px;
        color: #2e7d32;
        font-size: 15px;
        text-align: center;
        font-weight: 600;
      }

      .footer {
        margin-top: 35px;
        text-align: center;
        font-size: 12px;
        color: #777;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h2>KYC Verified Successfully 🎉</h2>
      </div>

      <p>Hello {{userName}},</p>

      <p>
        Congratulations! Your KYC documents have been reviewed and verified
        successfully by our team.
      </p>

      <p>
        Thank you for completing your identity verification. All premium
        features on your account are now unlocked, and you can start redeeming
        your rewards.
      </p>

      <div class="info-box">
        Your verification is complete. You're ready to start scan and earn!
      </div>

      <div class="footer">
        <p>Thank you for choosing Hydacon.</p>
        <p>Hydacon Support Team</p>
      </div>
    </div>
  </body>

</html>