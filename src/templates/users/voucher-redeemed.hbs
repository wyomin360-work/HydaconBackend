<html
  lang="en"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Your Voucher Is Ready</title>
    <!--[if mso]>
<noscript>
  <xml>
    <o:OfficeDocumentSettings>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
</noscript>
<style>
  table, td { border-collapse: collapse; }
</style>
<![endif]-->
    <style>
      html,
      body {
        margin: 0 !important;
        padding: 0 !important;
        height: 100% !important;
        width: 100% !important;
        background-color: #eef1f5;
      }
      * {
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        border: 0;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
        display: block;
      }
      a {
        text-decoration: none;
      }
      .body-font {
        font-family: "Segoe UI", Helvetica, Arial, sans-serif;
      }
      @media only screen and (max-width: 600px) {
        .email-container {
          width: 100% !important;
          max-width: 100% !important;
        }
        .fluid-padding {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .stack {
          display: block !important;
          width: 100% !important;
          text-align: left !important;
        }
        .code-text {
          font-size: 20px !important;
          letter-spacing: 3px !important;
        }
      }
    </style>
  </head>
  <body
    class="body-font"
    style="margin:0; padding:0; background-color:#EEF1F5;"
  >

    <!-- Preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
      Your
      {{giftName}}
      voucher is ready — code and details inside.
    </div>
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
      &#8203;&#847; &nbsp;&#847; &nbsp;&#847; &nbsp;&#847; &nbsp;&#847;
      &nbsp;&#847;
    </div>

    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color:#EEF1F5;"
    >
      <tr>
        <td align="center" style="padding: 32px 16px;">

          <table
            role="presentation"
            class="email-container"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width:600px; max-width:600px;"
          >

            <!-- Header band -->
            <tr>
              <td
                align="center"
                bgcolor="#0E2A22"
                style="background-color:#0E2A22; border-radius:16px 16px 0 0; padding: 28px 32px 24px;"
              >
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                >
                  <tr>
                    <td
                      align="center"
                      style="border-bottom: 2px solid #D4AF37; padding-bottom: 20px;"
                    >
                      <span
                        style="font-size:13px; font-weight:700; letter-spacing:3px; color:#D4AF37; text-transform:uppercase;"
                      >
                        HYDACON
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-top: 22px;">
                      <span
                        style="display:block; font-size:12px; font-weight:700; letter-spacing:2px; color:#D4AF37; text-transform:uppercase;"
                      >
                        Voucher Unlocked
                      </span>
                      <span
                        class="body-font"
                        style="display:block; font-size:26px; font-weight:700; color:#FFFFFF; margin-top:8px; line-height:1.3;"
                      >
                        Your reward is ready
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main card -->
            <tr>
              <td
                bgcolor="#FFFFFF"
                class="fluid-padding"
                style="background-color:#FFFFFF; padding: 36px 40px; border-radius: 0 0 16px 16px;"
              >
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                >

                  <!-- Greeting -->
                  <tr>
                    <td
                      style="font-size:16px; color:#1A1A1A; line-height:1.6; padding-bottom: 8px;"
                    >
                      Hi
                      {{userName}},
                    </td>
                  </tr>
                  <tr>
                    <td
                      style="font-size:14px; color:#6B6B6B; line-height:1.7; padding-bottom: 28px;"
                    >
                      You've redeemed your Hydacon Coins for the reward below.
                      Everything you need to use it is right here.
                    </td>
                  </tr>

                  <!-- Gift info row -->
                  <tr>
                    <td style="padding-bottom: 28px;">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border:1px solid #ECECEC; border-radius:12px;"
                      >
                        <tr>
                          <td style="padding: 18px 20px;">
                            <table
                              role="presentation"
                              width="100%"
                              cellpadding="0"
                              cellspacing="0"
                              border="0"
                            >
                              <tr>
                                <td
                                  style="font-size:16px; font-weight:700; color:#1A1A1A;"
                                >
                                  {{giftName}}
                                </td>
                                <td
                                  align="right"
                                  style="font-size:13px; font-weight:700; color:#B8860B; white-space:nowrap;"
                                >
                                  {{coinsUsed}}
                                  Coins
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  {{#if isCode}}
                    <!-- Voucher code panel -->
                    <tr>
                      <td
                        style="font-size:11px; font-weight:700; letter-spacing:1.5px; color:#9A9A9A; text-transform:uppercase; padding-bottom:12px;"
                      >
                        Your Code
                      </td>
                    </tr>
                    <tr>
                      <td style="padding-bottom: 28px;">
                        <table
                          role="presentation"
                          width="100%"
                          cellpadding="0"
                          cellspacing="0"
                          border="0"
                          style="background-color:#0E2A22; border-radius:14px;"
                        >
                          <tr>
                            <td align="center" style="padding: 26px 20px;">
                              <span
                                style="display:block; font-size:11px; font-weight:700; letter-spacing:2px; color:rgba(212,175,55,0.75); text-transform:uppercase; padding-bottom:14px;"
                              >
                                Redeem With This Code
                              </span>
                              <table
                                role="presentation"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                                style="margin: 0 auto;"
                              >
                                <tr>
                                  <td
                                    class="code-text"
                                    style="font-family:'Courier New', Courier, monospace; font-size:24px; font-weight:700; letter-spacing:5px; color:#D4AF37; background-color:rgba(212,175,55,0.08); border:1.5px dashed rgba(212,175,55,0.45); border-radius:10px; padding:14px 26px;"
                                  >
                                    {{voucherCode}}
                                  </td>
                                </tr>
                              </table>
                              <span
                                style="display:block; font-size:12px; color:rgba(255,255,255,0.45); padding-top:14px;"
                              >
                                Enter this code at checkout to claim your reward
                              </span>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  {{/if}}

                  {{#if isFile}}
                    <!-- Voucher file download -->
                    <tr>
                      <td
                        style="font-size:11px; font-weight:700; letter-spacing:1.5px; color:#9A9A9A; text-transform:uppercase; padding-bottom:12px;"
                      >
                        Your Voucher File
                      </td>
                    </tr>
                    <tr>
                      <td
                        style="font-size:14px; color:#6B6B6B; line-height:1.7; padding-bottom:20px;"
                      >
                        Your voucher file is ready to download. Open it for full
                        instructions on how to use your reward.
                      </td>
                    </tr>
                    <tr>
                      <td align="center" style="padding-bottom: 28px;">
                        <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{voucherFileUrl}}" style="height:50px;v-text-anchor:middle;width:240px;" arcsize="50%" fillcolor="#D4AF37" stroke="f">
                    <w:anchorlock/>
                    <center style="color:#0E2A22;font-family:sans-serif;font-size:15px;font-weight:bold;">Download Your Voucher</center>
                    </v:roundrect>
                    <![endif]-->
                        <!--[if !mso]><!-->
                        <a
                          href="{{voucherFileUrl}}"
                          target="_blank"
                          rel="noopener noreferrer"
                          style="background-color:#D4AF37; color:#0E2A22; font-size:15px; font-weight:700; letter-spacing:0.3px; padding:15px 36px; border-radius:999px; display:inline-block;"
                        >
                          Download Your Voucher
                        </a>
                        <!--<![endif]-->
                      </td>
                    </tr>
                  {{/if}}

                  <!-- Divider -->
                  <tr>
                    <td
                      style="border-top:1px solid #ECECEC; padding-top:24px;"
                    ></td>
                  </tr>

                  <!-- Summary -->
                  <tr>
                    <td style="padding-bottom: 24px;">
                      <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="border:1px solid #E8DDBB; border-radius:12px;"
                      >
                        <tr>
                          <td style="padding: 16px 20px;">
                            <table
                              role="presentation"
                              width="100%"
                              cellpadding="0"
                              cellspacing="0"
                              border="0"
                            >
                              <tr>
                                <td
                                  style="font-size:13px; font-weight:600; color:#7A6A3D;"
                                >
                                  Coins Redeemed
                                </td>
                                <td
                                  align="right"
                                  style="font-size:17px; font-weight:800; color:#B8860B;"
                                >
                                  {{coinsUsed}}
                                  Coins
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Support note -->
                  <tr>
                    <td
                      align="center"
                      style="font-size:13px; color:#9A9A9A; line-height:1.7;"
                    >
                      Need help with your voucher? Our support team is here for
                      you.
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding: 28px 24px;">
                <span
                  style="display:block; font-size:12px; color:#8A8A8A; line-height:1.8;"
                >
                  Thank you for choosing
                  <strong style="color:#5A5A5A;">Hydacon</strong>.
                </span>
                <span
                  style="display:block; font-size:12px; color:#8A8A8A; line-height:1.8;"
                >
                  &copy;
                  {{year}}
                  Hydacon. All rights reserved.
                </span>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>